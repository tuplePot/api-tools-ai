{
	"name": "ai-tools-api",
	"version": "1.0.50",
	"scripts": {
		"test": "bun test tests/",
		"eval": "bun run evals/run.ts",
		"gen": "bun run scripts/gen-registry.ts",
		"start": "bun run src/index.ts",
		"dev": "bun run scripts/gen-registry.ts && bun run --watch src/index.ts",
		"build": "bun run scripts/gen-registry.ts && bun build src/index.ts --outdir dist --target bun",
		"vercel-build": "bun run scripts/gen-registry.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@elysia/bearer": "^1.4.4",
		"@elysia/cors": "^1.4.2",
		"@elysia/jwt": "^1.4.2",
		"@elysia/openapi": "^1.4.16",
		"chokidar": "^5.0.0",
		"elysia": "^1.4.30",
		"gray-matter": "^4.0.3",
		"ioredis": "^6.0.0",
		"mongoose": "7",
		"openai": "^7.15.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"bun-types": "latest",
		"typescript": "^5.7.0"
	},
	"module": "src/index.js"
}
